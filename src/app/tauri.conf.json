{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MO Spectator HUD",
  "version": "0.1.4",
  "identifier": "com.mospectator.hud",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../overlay/*.html": "demo/",
      "../overlay/*.css": "demo/",
      "../overlay/*.js": "demo/",
      "../overlay/assets/*.js": "demo/assets/",
      "../overlay/assets/flags/*.png": "demo/assets/flags/",
      "../overlay/assets/icons/*": "demo/assets/icons/",
      "../overlay/custom_icons/README.txt": "demo/custom_icons/README.txt",
      "../console/*.html": "hud/",
      "../console/*.css": "hud/",
      "../console/*.js": "hud/",
      "../console/pages/*.js": "hud/pages/",
      "../console/img/*": "hud/img/",
      "../bridge/hud_bridge.exe": "hud_bridge.exe",
      "../bridge/unit_count_rules.default.ini": "unit_count_rules.default.ini",
      "../../assets/icons/*.png": "icons/",
      "../../assets/icons/byid/*.png": "icons/byid/",
      "../../assets/icons/sw/*.png": "icons/sw/"
    }
  }
}
